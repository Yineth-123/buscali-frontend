# URL del API (opcional). En Expo Web en la misma PC: http://localhost:3001
# En celular físico NO uses localhost (es el propio teléfono). Opciones:
#   - Deja vacío EXPO_PUBLIC_API_URL: la app usará la IP que Expo detecta (LAN) + puerto abajo.
#   - O pon la IP manual: EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
#
# Usa siempre http en desarrollo local (el backend Express no suele usar TLS).
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Puerto si solo usas detección LAN (sin URL completa). Debe coincidir con PORT del backend.
EXPO_PUBLIC_API_PORT=3001

# Google Maps (opcional)
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=
