# Expo Web (navegador) en la misma PC que el backend: suele valer http://localhost:3000
# (el backend debe permitir CORS; en buscali-backend ya está configurado).
#
# Opcional: si el registro falla con "network request failed", define la URL del API.
# En celular físico, localhost NO es tu PC.
#
# Modo LAN (npm start, mismo WiFi): suele bastar sin .env; si no, pon la IP de tu PC:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
#
# Modo túnel (npm run start:tunnel): Metro no es tu IP; casi siempre necesitas:
#   EXPO_PUBLIC_API_URL=http://TU_IP_LOCAL:3000
#
# Emulador Android:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps Platform (misma clave para mapa nativo + Geocoding inverso).
# Crea un proyecto en Google Cloud, habilita: Maps SDK for Android, Maps SDK for iOS, Geocoding API.
# Restringe la clave por app Android/iOS en producción.
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=tu_clave_aqui
